{
  "name": "shopbgremover",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "d1:backup": "bash scripts/backup_d1.sh",
    "d1:migrate:remote": "bash scripts/migrate_d1_remote.sh",
    "benchmark:local-inpaint": "node scripts/benchmark_local_inpaint.mjs",
    "benchmark:local-inpaint:candidates": "node scripts/compare_local_inpaint_candidates.mjs",
    "validation:local-inpaint": "python3 -m http.server 4173 --bind 127.0.0.1",
    "pages:build": "node scripts/build_static_pages.mjs",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .pages-dist --project-name shopbgremover --branch main",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:backup && npm run test:frontend && npm run test:worker",
    "test:backup": "node --test tests/d1-backup.test.mjs",
    "test:frontend": "node --test tests/frontend-stage1.test.mjs tests/local-inpaint.test.mjs tests/local-inpaint-quality.test.mjs tests/local-inpaint-candidates.test.mjs tests/local-inpaint-validation.test.mjs tests/ai-workflow.test.mjs tests/product-organizer.test.mjs",
    "test:worker": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@auth/d1-adapter": "^1.11.1",
    "jszip": "^3.10.1",
    "next": "15.5.2",
    "next-auth": "^5.0.0-beta.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
